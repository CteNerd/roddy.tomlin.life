ableErrorCount":0,"fixableWarningCount":0,"source":"61","usedDeprecatedRules":"42"},{"filePath":"62","messages":"63","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"64","usedDeprecatedRules":"42"},{"filePath":"65","messages":"66","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"42"},{"filePath":"67","messages":"68","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"69","usedDeprecatedRules":"42"},{"filePath":"70","messages":"71","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"72","messages":"73","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"42"},{"filePath":"74","messages":"75","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"42"},{"filePath":"76","messages":"77","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"42"},{"filePath":"78","messages":"79","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"42"},{"filePath":"80","messages":"81","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},"/Users/rctii/Projects/roddy.tomlin.life/src/index.js",[],["82","83"],"/Users/rctii/Projects/roddy.tomlin.life/src/reportWebVitals.js",[],"/Users/rctii/Projects/roddy.tomlin.life/src/App.js",["84"],"/Users/rctii/Projects/roddy.tomlin.life/src/app/Main.js",[],"/Users/rctii/Projects/roddy.tomlin.life/src/app/home/home.js",[],"/Users/rctii/Projects/roddy.tomlin.life/src/app/about/about.js",[],"/Users/rctii/Projects/roddy.tomlin.life/src/app/footer/footer.js",[],"/Users/rctii/Projects/roddy.tomlin.life/src/app/side-nav/SideNav.js",["85","86","87","88","89"],"/Users/rctii/Projects/roddy.tomlin.life/src/app/side-nav/sideNav.js",["90","91","92","93"],"/Users/rctii/Projects/roddy.tomlin.life/src/app/workouts/workouts.js",["94","95"],"import React, { useEffect, useState } from \"react\";\nimport { httpGetRequest } from \"../../httpClient/client\";\nimport \"./workouts.css\";\n\nexport default function Workouts() {\n  const moment = require(\"moment\");\n  const [youtubeVideos, setYoutubeVideos] = useState();\n\n  useEffect(async () => {\n    let responseVideo = {};\n    let responseVideos = [];\n    let response = await httpGetRequest({\n      url:\n        \"https://www.googleapis.com/youtube/v3/search?key=AIzaSyCDDwVn1sr9_LIIyTLo0WfCy3kC6jIFY3w&channelId=UCvuHQc2R10QDv_Qa2GeG4kg&part=snippet,id&order=date&maxResults=50\",\n    });\n    response.items.forEach((item) => {\n      if (item.id.kind === \"youtube#video\") {\n        responseVideo = {\n          id: item.id.videoId,\n          title: item.snippet.title,\n          date: moment(item.snippet.publishedAt).format(\"MMMM Do YYYY\"),\n        };\n        responseVideos.push(responseVideo);\n      }\n    });\n    setYoutubeVideos(responseVideos);\n  }, []);\n\n  const columns = [\n    {\n      title: \"Title\",\n      dataIndex: \"title\",\n      key: \"title\",\n    },\n    {\n      title: \"Date\",\n      dataIndex: \"date\",\n      key: \"date\",\n    },\n    {\n      title: \"Video Url\",\n      dataIndex: \"link\",\n      key: \"link\",\n    },\n  ];\n\n  function TableData() {\n    let content = [];\n    if (youtubeVideos) {\n      youtubeVideos.forEach((data) => {\n        content.push(\n          <tr>\n            <td>{data.title}</td>\n            <td>{data.date}</td>\n            <td>\n              <iframe\n                width=\"360\"\n                height=\"220\"\n                title={data.title}\n                src={\"https://www.youtube.com/embed/\" + data.id}\n                frameborder=\"0\"\n                allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\"\n                allowfullscreen\n              ></iframe>\n            </td>\n          </tr>\n        );\n      });\n    }\n    return <>{content}</>;\n  }\n\n  function Columns() {\n    let content = [];\n\n    columns.forEach((column) => {\n      content.push(<th>{column.title}</th>);\n    });\n    return <>{content}</>;\n  }\n\n  return (\n    <>\n      <h1>Workouts</h1>\n      <table className={\"tt\"}>\n        <tr>\n          <Columns />\n        </tr>\n        <TableData />\n      </table>\n    </>\n  );\n}\n","/Users/rctii/Projects/roddy.tomlin.life/src/httpClient/client.js",["96","97"],"import axios, { AxiosRequestConfig } from \"axios\";\n\nconst client = axios.create();\n\n// Wrapper for axios' requests.\nexport const httpGetRequest = function (options) {\n  const onSuccess = function (response) {\n    return response.data;\n  };\n  const onError = function (error) {\n    return Promise.reject(error.response || error.message);\n  };\n\n  return client(options).then(onSuccess).catch(onError);\n};\n\n// Wrapper for axios' requests.\nexport const httpPostRequest = function (url, requestBody = null) {\n  const onSuccess = function (response) {\n    return response.data;\n  };\n  const onError = function (error) {\n    return Promise.reject(error.response || error.message);\n  };\n\n  return client.post(url, requestBody).then(onSuccess).catch(onError);\n};\n\n// Wrapper for axios put requests.\nexport const httpPutRequest = function (options, data) {\n  const onSuccess = function (response) {\n    return response.data;\n  };\n  const onError = function (error) {\n    return Promise.reject(error.response || error.message);\n  };\n\n  return client.put(options, data).then(onSuccess).catch(onError);\n};\n\n// Wrapper for axios put requests.\nexport const httpDeleteRequest = function (options) {\n  const onSuccess = function (response) {\n    return response.data;\n  };\n  const onError = function (error) {\n    return Promise.reject(error.response || error.message);\n  };\n\n  return client(options).then(onSuccess).catch(onError);\n};\n\nexport default {\n  httpGetRequest,\n  httpPostRequest,\n  httpPutRequest,\n};\n","/Users/rctii/Projects/roddy.tomlin.life/src/app/woodshop/woodshop.js",[],"/Users/rctii/Projects/roddy.tomlin.life/src/shared-components/card/card.js",["98"],"import React from \"react\";\nimport './card.css'\n\nexport default function Card(props) {\n  return (\n    <div className=\"card\">\n      <a href={props.url}>\n        <img src={props.src} style={{ width: \"160px\", height: \"90px\" }} />\n        <h3>{props.title}</h3>\n        <p>{props.description}</p>\n      </a>\n    </div>\n  );\n}\n","/Users/rctii/Projects/roddy.tomlin.life/src/app/woodshop/plyobox.js",["99","100"],"/Users/rctii/Projects/roddy.tomlin.life/src/shared-components/page-header/page-header.js",[],"/Users/rctii/Projects/roddy.tomlin.life/src/app/football/hsFootball.js",[],"/Users/rctii/Projects/roddy.tomlin.life/src/app/football/ncaaFootball.js",[],"/Users/rctii/Projects/roddy.tomlin.life/src/app/football/nflFootball.js",[],"/Users/rctii/Projects/roddy.tomlin.life/src/shared-components/placeholder-text/placeholder-text.js",[],{"ruleId":"101","replacedBy":"102"},{"ruleId":"103","replacedBy":"104"},{"ruleId":"105","severity":1,"message":"106","line":25,"column":7,"nodeType":"107","endLine":25,"endColumn":54},{"ruleId":"108","severity":1,"message":"109","line":16,"column":11,"nodeType":"107","endLine":16,"endColumn":76},{"ruleId":"110","severity":1,"message":"111","line":16,"column":19,"nodeType":"112","messageId":"113","endLine":16,"endColumn":39},{"ruleId":"108","severity":1,"message":"109","line":25,"column":13,"nodeType":"107","endLine":25,"endColumn":25},{"ruleId":"108","severity":1,"message":"109","line":26,"column":13,"nodeType":"107","endLine":26,"endColumn":25},{"ruleId":"108","severity":1,"message":"109","line":27,"column":13,"nodeType":"107","endLine":27,"endColumn":25},{"ruleId":"108","severity":1,"message":"109","line":32,"column":7,"nodeType":"107","endLine":32,"endColumn":72},{"ruleId":"110","severity":1,"message":"111","line":32,"column":15,"nodeType":"112","messageId":"113","endLine":32,"endColumn":35},{"ruleId":"108","severity":1,"message":"109","line":71,"column":9,"nodeType":"107","endLine":71,"endColumn":21},{"ruleId":"108","severity":1,"message":"109","line":72,"column":9,"nodeType":"107","endLine":72,"endColumn":21},{"ruleId":"114","severity":1,"message":"115","line":9,"column":13,"nodeType":"116","endLine":27,"endColumn":4},{"ruleId":"114","severity":1,"message":"117","line":27,"column":6,"nodeType":"118","endLine":27,"endColumn":8,"suggestions":"119"},{"ruleId":"120","severity":1,"message":"121","line":1,"column":17,"nodeType":"122","messageId":"123","endLine":1,"endColumn":35},{"ruleId":"124","severity":1,"message":"125","line":53,"column":1,"nodeType":"126","endLine":57,"endColumn":3},{"ruleId":"105","severity":1,"message":"106","line":8,"column":9,"nodeType":"107","endLine":8,"endColumn":75},{"ruleId":"105","severity":1,"message":"106","line":96,"column":9,"nodeType":"107","endLine":96,"endColumn":65},{"ruleId":"105","severity":1,"message":"106","line":97,"column":9,"nodeType":"107","endLine":97,"endColumn":67},"no-native-reassign",["127"],"no-negated-in-lhs",["128"],"jsx-a11y/alt-text","img elements must have an alt prop, either with meaningful text, or an empty string for decorative images.","JSXOpeningElement","jsx-a11y/anchor-is-valid","The href attribute requires a valid value to be accessible. Provide a valid, navigable address as the href value. If you cannot provide a valid href, but still need the element to resemble a link, use a button and change it with appropriate styles. Learn more: https://github.com/evcohen/eslint-plugin-jsx-a11y/blob/master/docs/rules/anchor-is-valid.md","no-script-url","Script URL is a form of eval.","Literal","unexpectedScriptURL","react-hooks/exhaustive-deps","Effect callbacks are synchronous to prevent race conditions. Put the async function inside:\n\nuseEffect(() => {\n  async function fetchData() {\n    // You can await here\n    const response = await MyAPI.getData(someId);\n    // ...\n  }\n  fetchData();\n}, [someId]); // Or [] if effect doesn't need props or state\n\nLearn more about data fetching with Hooks: https://reactjs.org/link/hooks-data-fetching","ArrowFunctionExpression","React Hook useEffect has a missing dependency: 'moment'. Either include it or remove the dependency array.","ArrayExpression",["129"],"no-unused-vars","'AxiosRequestConfig' is defined but never used.","Identifier","unusedVar","import/no-anonymous-default-export","Assign object to a variable before exporting as module default","ExportDefaultDeclaration","no-global-assign","no-unsafe-negation",{"desc":"130","fix":"131"},"Update the dependencies array to be: [moment]",{"range":"132","text":"133"},[952,954],"[moment]"]