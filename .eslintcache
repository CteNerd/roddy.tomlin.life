>\n          <Footer />\n        </footer>\n    </>\n  );\n}\n\nfunction MenuButton() {\n  return (\n    <div>\n      <div className={'banner'} onClick={openNav}>\n        <div className={'menu-button col-4'}>\n          <div></div>\n          <div></div>\n          <div></div>\n        </div>\n      </div>\n    </div>\n  );\n}\n\n/* Set the width of the side navigation to 250px */\nfunction openNav() {\n  if (document.getElementById(\"mySidenav\") && document.getElementById(\"main\"))\n    document.getElementById(\"mySidenav\").style.width = \"200px\";\n}\n\nexport default App;\n",["105","106"],"/Volumes/@d.o.n.-tomlinHD 1/rctii/Projects/roddy.tomlin.life/src/app/Main.js",[],"/Volumes/@d.o.n.-tomlinHD 1/rctii/Projects/roddy.tomlin.life/src/app/footer/footer.js",[],"/Volumes/@d.o.n.-tomlinHD 1/rctii/Projects/roddy.tomlin.life/src/app/side-nav/sideNav.js",[],"/Volumes/@d.o.n.-tomlinHD 1/rctii/Projects/roddy.tomlin.life/src/app/about/about.js",[],"/Volumes/@d.o.n.-tomlinHD 1/rctii/Projects/roddy.tomlin.life/src/app/about/childhood.js",[],"/Volumes/@d.o.n.-tomlinHD 1/rctii/Projects/roddy.tomlin.life/src/app/about/nfl.js",[],"/Volumes/@d.o.n.-tomlinHD 1/rctii/Projects/roddy.tomlin.life/src/app/workouts/workouts.js",["107","108"],"/Volumes/@d.o.n.-tomlinHD 1/rctii/Projects/roddy.tomlin.life/src/app/about/wedding.js",[],"/Volumes/@d.o.n.-tomlinHD 1/rctii/Projects/roddy.tomlin.life/src/app/workouts/workouts-instructional.js",["109","110"],"/Volumes/@d.o.n.-tomlinHD 1/rctii/Projects/roddy.tomlin.life/src/app/football/hsFootball.js",[],"/Volumes/@d.o.n.-tomlinHD 1/rctii/Projects/roddy.tomlin.life/src/app/football/ncaaFootball.js",[],"/Volumes/@d.o.n.-tomlinHD 1/rctii/Projects/roddy.tomlin.life/src/app/football/nflFootball.js",[],"/Volumes/@d.o.n.-tomlinHD 1/rctii/Projects/roddy.tomlin.life/src/app/woodshop/plyobox.js",["111","112"],"/Volumes/@d.o.n.-tomlinHD 1/rctii/Projects/roddy.tomlin.life/src/app/about/it.js",[],"/Volumes/@d.o.n.-tomlinHD 1/rctii/Projects/roddy.tomlin.li