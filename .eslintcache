deNav() {\n  const [showBallDropdown, setShowBallDropdown] = useState(false);\n  const [showProjectsDropdown, setShowProjectsDropdown] = useState(false);\n  const [showSocialDropdown, setShowSocialDropdown] = useState(false);\n\n  /* Set the width of the side navigation to 0 */\n  function closeNav() {\n    if (document.getElementById(\"mySidenav\"))\n      document.getElementById(\"mySidenav\").style.width = \"0\";\n    document.body.style.backgroundColor = \"white\";\n  }\n\n  return (\n    <div id=\"mySidenav\" class=\"sidenav\">\n      <a href=\"javascript:void(0)\" class=\"closebtn\" onClick={closeNav}>\n        &times;\n      </a>\n      <a href=\"/\">\n        <HomeOutlined /> Home\n      </a>\n      <a href=\"/about\">\n        <SmileOutlined spin /> About\n      </a>\n      <button\n        onClick={() => setShowBallDropdown(!showBallDropdown)}\n        class=\"dropdown-btn\"\n      >\n        <TrophyOutlined /> Ball Is Life\n        <CaretDownOutlined className={\"fa-caret-down\"} />\n      </button>\n      <div\n        class=\"dropdown-container\"\n        style={{ display: showBallDropdown ? \"block\" : \"none\" }}\n      >\n        <a href=\"#\">High School</a>\n        <a href=\"#\">College</a>\n        <a href=\"#\">Professional</a>\n        <a href=\"/workouts\">Workouts</a>\n      </div>\n      <button\n        onClick={() => setShowProjectsDropdown(!showProjectsDropdown)}\n        class=\"dropdown-btn\"\n      >\n        <GithubOutlined /> Projects\n        <CaretDownOutlined className={\"fa-caret-down\"} />\n      </button>\n      <div\n        class=\"dropdown-container\"\n        style={{ display: showProjectsDropdown ? \"block\" : \"none\" }}\n      >\n        <a href=\"https://ttyltutors.com\">TTYL</a>\n        <a href=\"https://www.pearlrae.com\">Pearl Rae</a>\n        <a href=\"https://jimmyjamkalewraps.com\">Jimmy Jam Kale Wrap</a>\n        <a href=\"#\">We'll Call Tix</a>\n        <a href=\"#\">We'll Call Consulting</a>\n        <a href=\"#\">Woodshop</a>\n      </div>\n      <button\n        onClick={() => setShowSocialDropdown(!showSocialDropdown)}\n        class=\"dropdown-btn\"\n      >\n        <UsergroupAddOutlined /> Social\n        <CaretDownOutlined className={\"fa-caret-down\"} />\n      </button>\n      <div\n        class=\"dropdown-container\"\n        style={{ display: showSocialDropdown ? \"block\" : \"none\" }}\n      >\n        <a href=\"https://www.facebook.com/roddy.tomlin.3\">\n          <FacebookOutlined /> Facebook\n        </a>\n        <a href=\"https://www.linkedin.com/in/tutoringrod/\">\n          <LinkedinOutlined /> LinkedIn\n        </a>\n        <a href=\"https://twitter.com/rct_62\">\n          <TwitterOutlined /> Twitter\n        </a>\n        <a href=\"https://www.instagram.com/d.o.n._tomlin/\">\n          <InstagramOutlined /> Instagram\n        </a>\n      </div>\n    </div>\n  );\n}\n","/Users/rctii/Projects/roddy.tomlin.life/src/app/workouts/workouts.js",["64"],"/Users/rctii/Projects/roddy.tomlin.life/src/httpClient/client.js",["65","66"],"import axios, { AxiosRequestConfig } from \"axios\";\n\nconst client = axios.create();\n\n// Wrapper for axios' requests.\nexport const httpGetRequest = function (options) {\n  const onSuccess = function (response) {\n    return response.data;\n  };\n  const onError = function (error) {\n    return Promise.reject(error.response || error.message);\n  };\n\n  return client(options).then(onSuccess).catch(onError);\n};\n\n// Wrapper for axios' requests.\nexport const httpPostRequest = function (url, requestBody = null) {\n  const onSuccess = function (response) {\n    return response.data;\n  };\n  const onError = function (error) {\n    return Promise.reject(error.response || error.message);\n  };\n\n  return client.post(url, requestBody).then(onSuccess).catch(onError);\n};\n\n// Wrapper for axios put requests.\nexport const httpPutRequest = function (options, data) {\n  const onSuccess = function (response) {\n    return response.data;\n  };\n  const onError = function (error) {\n    return Promise.reject(error.response || error.message);\n  };\n\n  return client.put(options, data).then(onSuccess).catch(onError);\n};\n\n// Wrapper for axios put requests.\nexport const httpDeleteRequest = function (options) {\n  const onSuccess = function (response) {\n    return response.data;\n  };\n  const onError = function (error) {\n    return Promise.reject(error.response || error.message);\n  };\n\n  return client(options).then(onSuccess).catch(onError);\n};\n\nexport default {\n  httpGetRequest,\n  httpPostRequest,\n  httpPutRequest,\n};\n",{"ruleId":"67","replacedBy":"68"},{"ruleId":"69","replacedBy":"70"},{"ruleId":"71","severity":1,"message":"72","line":16,"column":11,"nodeType":"73","endLine":16,"endColumn":76},{"ruleId":"74","severity":1,"message":"75","line":16,"column":19,"nodeType":"76","messageId":"77","endLine":16,"endColumn":39},{"ruleId":"71","severity":1,"message":"72","line":25,"column":13,"nodeType":"73","endLine":25,"endColumn":25},{"ruleId":"71","severity":1,"message":"72","line":26,"column":13,"nodeType":"73","endLine":26,"endColumn":25},{"ruleId":"71","severity":1,"message":"72","line":27,"column":13,"nodeType":"73","endLine":27,"endColumn":25},{"ruleId":"71","severity":1,"message":"72","line":19,"column":7,"nodeType":"73","endLine":19,"endColumn":72},{"ruleId":"74","severity":1,"message":"75","line":19,"column":15,"nodeType":"76","messageId":"77","endLine":19,"endColumn":35},{"ruleId":"71","severity":1,"message":"72","line":32,"column":9,"nodeType":"73","endLine":32,"endColumn":21},{"ruleId":"71","severity":1,"message":"72","line":33,"column":9,"nodeType":"73","endLine":33,"endColumn":21},{"ruleId":"71","severity":1,"message":"72","line":34,"column":9,"nodeType":"73","endLine":34,"endColumn":21},{"ruleId":"71","severity":1,"message":"72","line":48,"column":9,"nodeType":"73","endLine":48,"endColumn":21},{"ruleId":"71","severity":1,"message":"72","line":49,"column":9,"nodeType":"73