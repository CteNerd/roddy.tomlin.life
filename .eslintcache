[{"/Users/rctii/Projects/roddy.tomlin.life/src/index.js":"1","/Users/rctii/Projects/roddy.tomlin.life/src/reportWebVitals.js":"2","/Users/rctii/Projects/roddy.tomlin.life/src/App.js":"3","/Users/rctii/Projects/roddy.tomlin.life/src/app/Main.js":"4","/Users/rctii/Projects/roddy.tomlin.life/src/app/home/home.js":"5","/Users/rctii/Projects/roddy.tomlin.life/src/app/about/about.js":"6","/Users/rctii/Projects/roddy.tomlin.life/src/app/footer/footer.js":"7","/Users/rctii/Projects/roddy.tomlin.life/src/app/side-nav/SideNav.js":"8","/Users/rctii/Projects/roddy.tomlin.life/src/app/side-nav/sideNav.js":"9","/Users/rctii/Projects/roddy.tomlin.life/src/app/workouts/workouts.js":"10","/Users/rctii/Projects/roddy.tomlin.life/src/httpClient/client.js":"11","/Users/rctii/Projects/roddy.tomlin.life/src/app/woodshop/woodshop.js":"12","/Users/rctii/Projects/roddy.tomlin.life/src/shared-components/card/card.js":"13","/Users/rctii/Projects/roddy.tomlin.life/src/app/woodshop/plyobox.js":"14","/Users/rctii/Projects/roddy.tomlin.life/src/shared-components/page-header/page-header.js":"15","/Users/rctii/Projects/roddy.tomlin.life/src/app/football/hsFootball.js":"16","/Users/rctii/Projects/roddy.tomlin.life/src/app/football/ncaaFootball.js":"17","/Users/rctii/Projects/roddy.tomlin.life/src/app/football/nflFootball.js":"18","/Users/rctii/Projects/roddy.tomlin.life/src/shared-components/placeholder-text/placeholder-text.js":"19","/Users/rctii/Projects/roddy.tomlin.life/src/app/workouts/workouts-instructional.js":"20","/Users/rctii/Projects/roddy.tomlin.life/src/app/about/it.js":"21","/Users/rctii/Projects/roddy.tomlin.life/src/app/about/childhood.js":"22","/Users/rctii/Projects/roddy.tomlin.life/src/app/about/college.js":"23","/Users/rctii/Projects/roddy.tomlin.life/src/app/about/nfl.js":"24"},{"size":500,"mtime":1608007195109,"results":"25","hashOfConfig":"26"},{"size":364,"mtime":1608007195125,"results":"27","hashOfConfig":"26"},{"size":885,"mtime":1608622469760,"results":"28","hashOfConfig":"26"},{"size":2159,"mtime":1609131080845,"results":"29","hashOfConfig":"26"},{"size":1762,"mtime":1609088845117,"results":"30","hashOfConfig":"26"},{"size":3082,"mtime":1609138056269,"results":"31","hashOfConfig":"26"},{"size":1143,"mtime":1608616931307,"results":"32","hashOfConfig":"26"},{"size":2752,"mtime":1608011709458,"results":"33","hashOfConfig":"26"},{"size":4178,"mtime":1609132703218,"results":"34","hashOfConfig":"26"},{"size":3408,"mtime":1609138089713,"results":"35","hashOfConfig":"26"},{"size":1495,"mtime":1608230641016,"results":"36","hashOfConfig":"26"},{"size":893,"mtime":1609138059073,"results":"37","hashOfConfig":"26"},{"size":302,"mtime":1609132704102,"results":"38","hashOfConfig":"26"},{"size":10478,"mtime":1608623587855,"results":"39","hashOfConfig":"26"},{"size":235,"mtime":1609138059401,"results":"40","hashOfConfig":"26"},{"size":505,"mtime":1608582960784,"results":"41","hashOfConfig":"26"},{"size":493,"mtime":1608582960796,"results":"42","hashOfConfig":"26"},{"size":556,"mtime":1608582960835,"results":"43","hashOfConfig":"26"},{"size":1631,"mtime":1608582963262,"results":"44","hashOfConfig":"26"},{"size":3279,"mtime":1609138059157,"results":"45","hashOfConfig":"26"},{"size":9445,"mtime":1609138056485,"results":"46","hashOfConfig":"26"},{"size":8459,"mtime":1609138056308,"results":"47","hashOfConfig":"26"},{"size":8852,"mtime":1609138056389,"results":"48","hashOfConfig":"26"},{"size":5168,"mtime":1609138056500,"results":"49","hashOfConfig":"26"},{"filePath":"50","messages":"51","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"52"},"7axd3u",{"filePath":"53","messages":"54","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"52"},{"filePath":"55","messages":"56","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"57","usedDeprecatedRules":"52"},{"filePath":"58","messages":"59","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"60","messages":"61","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"62","usedDeprecatedRules":"52"},{"filePath":"63","messages":"64","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"65","usedDeprecatedRules":"52"},{"filePath":"66","messages":"67","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"52"},{"filePath":"68","messages":"69","errorCount":0,"warningCount":5,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"70","messages":"71","errorCount":0,"warningCount":5,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"72","messages":"73","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"74","messages":"75","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"76","usedDeprecatedRules":"52"},{"filePath":"77","messages":"78","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"52"},{"filePath":"79","messages":"80","errorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"81","usedDeprecatedRules":"52"},{"filePath":"82","messages":"83","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"84","usedDeprecatedRules":"52"},{"filePath":"85","messages":"86","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"52"},{"filePath":"87","messages":"88","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"52"},{"filePath":"89","messages":"90","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"52"},{"filePath":"91","messages":"92","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"52"},{"filePath":"93","messages":"94","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"52"},{"filePath":"95","messages":"96","errorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"97","usedDeprecatedRules":"52"},{"filePath":"98","messages":"99","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"52"},{"filePath":"100","messages":"101","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"52"},{"filePath":"102","messages":"103","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"104","messages":"105","errorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"52"},"/Users/rctii/Projects/roddy.tomlin.life/src/index.js",[],["106","107"],"/Users/rctii/Projects/roddy.tomlin.life/src/reportWebVitals.js",[],"/Users/rctii/Projects/roddy.tomlin.life/src/App.js",["108"],"import \"./App.css\";\nimport Footer from \"./app/footer/footer\";\nimport SideNav from \"./app/side-nav/sideNav\";\nimport Main from \"./app/Main.js\";\nimport RtInitials from \"./images/RT initials cursive - transparent.png\";\n\nfunction App() {\n  return (\n    <>\n      <SideNav />\n      <div className=\"main\" id=\"main\">\n        <MenuButton />\n        <Main />\n        <footer>\n          <Footer />\n        </footer>\n      </div>\n    </>\n  );\n}\n\nfunction MenuButton() {\n  return (\n    <div className={\"menu-button\"} onClick={openNav}>\n      <img className={\"menu-img\"} src={RtInitials} />\n      <label>Menu</label>\n    </div>\n  );\n}\n\n/* Set the width of the side navigation to 250px */\nfunction openNav() {\n  console.log(\"opened\");\n  if (document.getElementById(\"mySidenav\") && document.getElementById(\"main\"))\n    document.getElementById(\"mySidenav\").style.width = \"200px\";\n}\n\nexport default App;\n","/Users/rctii/Projects/roddy.tomlin.life/src/app/Main.js",[],"/Users/rctii/Projects/roddy.tomlin.life/src/app/home/home.js",["109"],"import React from \"react\";\nimport FamilyPhoto from \"./family-photo.png\";\nimport PageHeader from \"../../shared-components/page-header/page-header\";\nimport \"./home.css\";\n\nexport default function Home() {\n  return (\n    <div className={\"home-css\"}>\n      <PageHeader\n        pageTitle={\"Roderick C Tomlin II\"}\n        pageDescription={\n          <p>The story, life, and r&eacute;sum&eacute; of Roddy Tomlin</p>\n        }\n      />\n      <div className={\"instruction-p\"}>\n        <div className={\"intro-img-container\"}>\n          <img className={\"intro-img\"} src={FamilyPhoto} />\n        </div>\n        <p>\n          In layman's terms, I am simply grateful and blessed to be where I am;\n          but I'll rest when I'm dead.\n        </p>\n        <p>\n          Throughout life I have been blessed to meet people that are in\n          different places within this race we call life. Listening to the words\n          of these people has opened my eyes to views I didn't think of prior to\n          the occassion. Rather it be learning from a rookie or the vet on\n          his/her way to be enshrined, I believe wisdom can come from anyone at\n          anytime.\n        </p>\n        <p>\n          Here, you will find the projects that I am grateful to have the\n          opportunities to work on, a little background on myself, background on\n          my path to the NFL, and a few hobbies I have been keeping myself busy\n          with.\n        </p>\n        <p>\n          If you would like to reach out to me about anything, feel free to\n          contact me via call, text, or email using the contact information\n          below. Also, take your own copy of my r&eacute;sum&eacute; which can\n          also be found below.\n        </p>\n      </div>\n    </div>\n  );\n}\n","/Users/rctii/Projects/roddy.tomlin.life/src/app/about/about.js",["110","111"],"import PlaceholderText from \"../../shared-components/placeholder-text/placeholder-text\";\nimport Card from \"../../shared-components/card/card\";\nimport \"./about.css\";\nimport React from \"react\";\nimport PageHeader from \"../../shared-components/page-header/page-header\";\n\nexport default function About() {\n  return (\n    <>\n      <PageHeader\n        pageTitle={\"About Roddy\"}\n        pageDescription={\n          \"Below are short snippets of parts of my life. Click on read more if you care to get a little more detail.\"\n        }\n      />\n\n      <div className={\"about-row\"}>\n        <div className={\"column\"}>\n          <div className=\"card\">\n            <h3>{\"Childhood\"}</h3>\n            <p>\n              Born in Mississippi, I've never had the feeling like I was born\n              and bred in The South. That could be due to the fact of being\n              relocated to San Diego before I had a chance to take in the\n              scenery but that was out of my control.\n            </p>\n            <p className=\"read-more\">\n              <button className=\"button\">\n                <a href={\"/about/childhood\"}>Read More</a>\n              </button>\n            </p>\n          </div>\n        </div>\n        <div className={\"column\"}>\n          <div className=\"card\">\n            <h3>{\"College\"}</h3>\n            <p>\n              College is supposed to be fun and interesting, if you know where\n              you're going. For me, I thought there were only two options:\n              Academic Scholarship and pay the rest at Rhodes University or same\n              thing and play football at Bethel College\n            </p>\n            <p className=\"read-more\">\n              <button className=\"button\">\n                <a href={\"/about/college\"}>Read More</a>\n              </button>\n            </p>\n          </div>\n        </div>\n        <div className={\"column\"}>\n          <div className=\"card\">\n            <h3>{\"NFL\"}</h3>\n            <p>\n              Life started to calm down being in the NFL. I was doing something\n              few had done before and the attention was all on me. What could go\n              wrong? Something, like always. I learned quickly of the level of\n              talent in the NFL.\n            </p>\n            <p className=\"read-more\">\n              <button className=\"button\">\n                <a href={\"/about/nfl\"}>Read More</a>\n              </button>\n            </p>\n          </div>\n        </div>\n        <div className={\"column\"}>\n          <div className=\"card\">\n            <h3>{\"IT\"}</h3>\n            <p>\n              Getting here was tough, but I had learned plenty along the way. I\n              left two different loves of my life in order to reset and find me.\n              While living in Alabama I ventured down the path of coaching\n              briefly, I wasn't ready.\n            </p>\n            <p className=\"read-more\">\n              <button className=\"button\">\n                <a href={\"/about/it\"}>Read More</a>\n              </button>\n            </p>\n          </div>\n        </div>\n      </div>\n    </>\n  );\n}\n","/Users/rctii/Projects/roddy.tomlin.life/src/app/footer/footer.js",[],"/Users/rctii/Projects/roddy.tomlin.life/src/app/side-nav/SideNav.js",["112","113","114","115","116"],"/Users/rctii/Projects/roddy.tomlin.life/src/app/side-nav/sideNav.js",["117","118","119","120","121"],"/Users/rctii/Projects/roddy.tomlin.life/src/app/workouts/workouts.js",["122","123"],"/Users/rctii/Projects/roddy.tomlin.life/src/httpClient/client.js",["124","125"],"import axios, { AxiosRequestConfig } from \"axios\";\n\nconst client = axios.create();\n\n// Wrapper for axios' requests.\nexport const httpGetRequest = function (options) {\n  const onSuccess = function (response) {\n    return response.data;\n  };\n  const onError = function (error) {\n    return Promise.reject(error.response || error.message);\n  };\n\n  return client(options).then(onSuccess).catch(onError);\n};\n\n// Wrapper for axios' requests.\nexport const httpPostRequest = function (url, requestBody = null) {\n  const onSuccess = function (response) {\n    return response.data;\n  };\n  const onError = function (error) {\n    return Promise.reject(error.response || error.message);\n  };\n\n  return client.post(url, requestBody).then(onSuccess).catch(onError);\n};\n\n// Wrapper for axios put requests.\nexport const httpPutRequest = function (options, data) {\n  const onSuccess = function (response) {\n    return response.data;\n  };\n  const onError = function (error) {\n    return Promise.reject(error.response || error.message);\n  };\n\n  return client.put(options, data).then(onSuccess).catch(onError);\n};\n\n// Wrapper for axios put requests.\nexport const httpDeleteRequest = function (options) {\n  const onSuccess = function (response) {\n    return response.data;\n  };\n  const onError = function (error) {\n    return Promise.reject(error.response || error.message);\n  };\n\n  return client(options).then(onSuccess).catch(onError);\n};\n\nexport default {\n  httpGetRequest,\n  httpPostRequest,\n  httpPutRequest,\n};\n","/Users/rctii/Projects/roddy.tomlin.life/src/app/woodshop/woodshop.js",[],"/Users/rctii/Projects/roddy.tomlin.life/src/shared-components/card/card.js",["126"],"import React from \"react\";\nimport \"./card.css\";\n\nexport default function Card(props) {\n  return (\n    <div className=\"card\">\n      <a href={props.url}>\n        <img src={props.src} className={\"card-img\"} />\n        <h3>{props.title}</h3>\n        <p>{props.description}</p>\n      </a>\n    </div>\n  );\n}\n","/Users/rctii/Projects/roddy.tomlin.life/src/app/woodshop/plyobox.js",["127","128"],"import React, { useState } from \"react\";\nimport PageHeader from \"../../shared-components/page-header/page-header\";\nimport plyoboxFront from \"./images/plyoboxFront.png\";\nimport plyoboxAngle from \"./images/plyoboxAngle.png\";\nimport \"./plyobox.css\";\n\nexport default function PlyoBox() {\n  const [measurementOne, setMeasurementOne] = useState(12);\n  const [measurementTwo, setMeasurementTwo] = useState(18);\n  const [measurementThree, setMeasurementThree] = useState(24);\n  const [woodThickness, setWoodThickness] = useState(0.75);\n  const [measurementTwoCut, setMeasurementTwoCut] = useState(\n    18 - 2 * woodThickness\n  );\n  const [measurementThreeCut, setMeasurementThreeCut] = useState(\n    24 - 2 * woodThickness\n  );\n\n  function handleUpdateClick() {\n    setMeasurementTwoCut(measurementTwo - 2 * woodThickness);\n    setMeasurementThreeCut(measurementThree - 2 * woodThickness);\n  }\n\n  return (\n    <>\n      <PageHeader\n        pageTitle={\"Plyometric Box\"}\n        pageDescription={\n          'Below you will find instructions on how I built my 12\" x 18\" x 24\" plyometrix box. If you would like to change the size of the box within the instructions, please change the measurements in the 3 boxes below and the instructions will update. Thank you.'\n        }\n      />\n      <div className={\"plyobox-custom-measurements\"}>\n        <label className={\"column-100\"}>Measurements</label>\n        <form\n          action={\"#\"}\n          onSubmit={() => {\n            handleUpdateClick();\n            return false;\n          }}\n        >\n          <div className={\"column-25\"}>\n            <label>Side 1</label>\n            <input\n              required\n              onChange={(e) => setMeasurementOne(e.target.value)}\n              min={1}\n              max={100}\n              defaultValue={12}\n              placeholder={\"12\"}\n              type={\"number\"}\n            />\n          </div>\n          <div className={\"column-25\"}>\n            <label>Side 2</label>\n            <input\n              required\n              onChange={(e) => setMeasurementTwo(e.target.value)}\n              min={1}\n              max={100}\n              placeholder={\"18\"}\n              defaultValue={18}\n              type={\"number\"}\n            />\n          </div>\n          <div className={\"column-25\"}>\n            <label>Side 3</label>\n            <input\n              required\n              onChange={(e) => setMeasurementThree(e.target.value)}\n              min={1}\n              max={100}\n              defaultValue={24}\n              placeholder={\"24\"}\n              type={\"number\"}\n            />\n          </div>\n          <div className={\"column-25\"}>\n            <label>Wood Thickness</label>\n            <input\n              required\n              onChange={(e) => setWoodThickness(e.target.value)}\n              min={0.0}\n              max={0.75}\n              defaultValue={0.75}\n              placeholder={0.75}\n              step={0.125}\n              type={\"number\"}\n            />\n          </div>\n          <div className={\"column-100\"}>\n            <button type={\"submit\"}>Update</button>\n          </div>\n        </form>\n      </div>\n      <div>\n        <img src={plyoboxFront} className={\"instruction-img\"} />\n        <img src={plyoboxAngle} className={\"instruction-img-2\"} />\n        <div className={\"instruction-p\"}>\n          <p>\n            To get started you will need to get the following supplies from your\n            local hardware store. If your local hardware store is kind enough to\n            cut your plywood, or whatever type of wood you choose, I highly\n            recommend getting those clean cuts done by the professionals unless\n            you are fortunate enough to have access to a table or circular saw.\n          </p>\n          <p>\n            Fun Fact: This 12\" x 18\" x 24\" box can be made twice from your\n            normal 4' x 8' plywood.\n          </p>\n          <p>And don't forget. MEASURE TWICE, CUT ONCE!!!</p>\n          <h4>Materials:</h4>\n          <table>\n            <tr>\n              <td>Cut Name</td>\n              <td>Quantity</td>\n              <td>Cut</td>\n            </tr>\n            <tr>\n              <td>Side Without Framework</td>\n              <td>2</td>\n              <td>\n                {measurementOne}\" x {measurementTwo}\"\n              </td>\n            </tr>\n            <tr>\n              <td>Base</td>\n              <td>2</td>\n              <td>\n                {measurementTwoCut}\" x {measurementThreeCut}\"\n              </td>\n            </tr>\n            <tr>\n              <td>Side With Framework</td>\n              <td>2</td>\n              <td>\n                {measurementThreeCut}\" x {measurementOne}\"\n              </td>\n            </tr>\n          </table>\n          <h4>And for framing:</h4>\n          <table>\n            <tr>\n              <td>Item</td>\n              <td>Quantity</td>\n              <td>Note</td>\n            </tr>\n            <tr>\n              <td>2\" x 2\" x 10' wood beams</td>\n              <td>3</td>\n              <td>These will be cut to frame the inside of the box.</td>\n            </tr>\n            <tr>\n              <td>#8 x 1.75\" wood screws</td>\n              <td>30</td>\n              <td></td>\n            </tr>\n            <tr>\n              <td>Sander</td>\n              <td>1</td>\n              <td></td>\n            </tr>\n            <tr>\n              <td>Sand paper</td>\n              <td>2</td>\n              <td>1 for chunks and 1 for smoothing</td>\n            </tr>\n            <tr>\n              <td>Drill</td>\n              <td>1</td>\n              <td></td>\n            </tr>\n            <tr>\n              <td>Drill bits</td>\n              <td>1</td>\n              <td>I used &#8539; drill bit</td>\n            </tr>\n            <tr>\n              <td>Phillips Screw Head</td>\n              <td>1</td>\n              <td>I prefer drill attachment, but manual is cool to.</td>\n            </tr>\n          </table>\n          <h4>Instructions:</h4>\n          <h5>Step 1:</h5>\n          <p>\n            Assuming the plywood is cut and ready to go, we will begin with\n            cutting the wood beams. We will need the following cuts in order to\n            frame the inside of the box. This is pivotal, think of this as the\n            support beams within your home.\n          </p>\n          <table style={{ float: \"left\", padding: \"5px\" }}>\n            <tr>\n              <td>Cut</td>\n              <td>Quantity</td>\n              <td>Note</td>\n            </tr>\n            <tr>\n              <td>{measurementTwoCut}\"</td>\n              <td>4</td>\n              <td>For Side A of the Base</td>\n            </tr>\n            <tr>\n              <td>{measurementThreeCut - 3}\"</td>\n              <td>4</td>\n              <td>For Side B of the Base.</td>\n            </tr>\n            <tr>\n              <td>{measurementOne - 4.5}\"</td>\n              <td>4</td>\n              <td>For {measurementOne}\" side of Sides with Framework</td>\n            </tr>\n          </table>\n          <p>\n            <strong>Note for Cut #2:</strong> My wood beams happened to be 1.5\"\n            thick rather than the expected 2\". This altered the cuts for Side B\n            can see in the table they are cut 3\" shorter, double 1.5\", rather\n            than 4\".\n          </p>\n          <p>\n            <strong>Note for Cut #3:</strong> This cut is for connecting the two\n            bases. It is cut 4.5\" shorter for the following reasons. First, to\n            account for the 1.5\" of the wood beams (3\"). Second, the remaining\n            1.5\" is from the thickness of the wood on each side.\n          </p>\n          <h5>Step 2:</h5>\n          <p>\n            After you have made your cuts from the wood beams, lay the framework\n            on the base and the side with framework to ensure the cuts are as\n            expected. If the framework needs any cleaning up, now is the time to\n            fix it. If all looks good, glue the framework to the base using wood\n            glue and allow to sit for the instructed time.\n          </p>\n          <h5>Step 3:</h5>\n          <p>\n            While the base is drying to the framework, begin working on the\n            sides with framework. Find the middle of the beam cut and align with\n            the middle of the sides with framework. There should be\n            approximately 2.25\" of space on each side of the wood beam cut\n            depending on the thickness of your plywood and wood beams. If this\n            looks good, glue as well with centers aligned.\n          </p>\n          <h5>Step 4:</h5>\n          <p>\n            After glue has dried, flip over framed sides and drill holes every\n            6\". If you choose to skip this step and go straight to drilling\n            screws that is fine, I prefer to pre-drill a small hole where I plan\n            to place screws. Once completed the framework should be secure to\n            the plywood sides.\n          </p>\n          <h5>Step 5:</h5>\n          <p>\n            Now that the framework is in place, begin by place the base on the\n            ground and match a side with framework to a side on the base with\n            the same length. The framework from the side piece should sit on the\n            base framework and allow for the plywood siding to be flush with the\n            plywood siding of the base. If this looks correct, connect the sides\n            in the corner. Continue to opposite side.\n          </p>\n          <h5>Step 6:</h5>\n          <p>\n            The remaining two sides should not have framework and this is\n            intentional, they will screw into the the sides with framework and\n            the base. Ensure the corners are 90&#176; prior to screwing or\n            drilling. To assist with clean corners, you can place the second\n            base in place while screwing the sides.\n          </p>\n          <h5>Step 7:</h5>\n          <p>\n            With all the sides and one base in place, lay the box on the base\n            side with the open side facing up. Using a mallot (and maybe a\n            flathead screwdriver), tap the edges of the remaining base into the\n            open side. This should be a snug, or even tight, fit. Once tapped\n            into place, drill and screw into place. The box is ready to go.\n          </p>\n          <p>\n            For finishing touches, I highly recommend sanding rough edges and\n            corners.\n          </p>\n        </div>\n      </div>\n    </>\n  );\n}\n","/Users/rctii/Projects/roddy.tomlin.life/src/shared-components/page-header/page-header.js",[],"/Users/rctii/Projects/roddy.tomlin.life/src/app/football/hsFootball.js",[],"/Users/rctii/Projects/roddy.tomlin.life/src/app/football/ncaaFootball.js",[],"/Users/rctii/Projects/roddy.tomlin.life/src/app/football/nflFootball.js",[],"/Users/rctii/Projects/roddy.tomlin.life/src/shared-components/placeholder-text/placeholder-text.js",[],"/Users/rctii/Projects/roddy.tomlin.life/src/app/workouts/workouts-instructional.js",["129","130"],"import React, { useEffect, useState } from \"react\";\nimport PageHeader from \"../../shared-components/page-header/page-header\";\nimport { httpGetRequest } from \"../../httpClient/client\";\nimport \"./workouts.css\";\n\nexport default function WorkoutInstructions() {\n  const moment = require(\"moment\");\n  const [youtubeVideos, setYoutubeVideos] = useState();\n\n  useEffect(async () => {\n    let responseVideo = {};\n    let responseVideos = [];\n    let response = await httpGetRequest({\n      url:\n        \"https://www.googleapis.com/youtube/v3/playlistItems?key=AIzaSyCDDwVn1sr9_LIIyTLo0WfCy3kC6jIFY3w&part=id,contentDetails,snippet&playlistId=PL-6JZMCvkoY-Uivi7OwyFkKZ6skPGgj8p&maxResults=50\",\n    });\n\n    response.items.forEach((item) => {\n      if (item.kind === \"youtube#playlistItem\") {\n        responseVideo = {\n          id: item.contentDetails.videoId,\n          title: item.snippet.title,\n          date: moment(item.contentDetails.videoPublishedAt).format(\n            \"MMMM Do YYYY\"\n          ),\n        };\n        responseVideos.push(responseVideo);\n      }\n    });\n    setYoutubeVideos(responseVideos);\n  }, []);\n\n  const columns = [\n    {\n      title: \"Title\",\n      dataIndex: \"title\",\n      key: \"title\",\n    },\n    {\n      title: \"Date\",\n      dataIndex: \"date\",\n      key: \"date\",\n    },\n    {\n      title: \"Instructional\",\n      dataIndex: \"link\",\n      key: \"link\",\n    },\n  ];\n\n  function TableData() {\n    let content = [];\n    if (youtubeVideos) {\n      youtubeVideos.forEach((data) => {\n        content.push(\n          <tr>\n            <td>{data.title}</td>\n            <td>{data.date}</td>\n            <td>\n              <iframe\n                width=\"360\"\n                height=\"220\"\n                title={data.title}\n                src={\"https://www.youtube.com/embed/\" + data.id}\n                frameborder=\"0\"\n                allow=\"accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\"\n                allowfullscreen\n              ></iframe>\n            </td>\n          </tr>\n        );\n      });\n    }\n    return <>{content}</>;\n  }\n\n  function Columns() {\n    let content = [];\n\n    columns.forEach((column) => {\n      content.push(<th>{column.title}</th>);\n    });\n    return <>{content}</>;\n  }\n\n  return (\n    <>\n      <PageHeader\n        pageTitle={\"Workout Instructionals\"}\n        pageDescription={\n          \"Thank you for coming by to hang with us. Below you will find instructional videos that will assist you in understanding the technique used during the workouts. If you have any questions or concerns, please feel free to reach out.\"\n        }\n      />\n      <p className={\"disclaimer\"}>\n        This website and video content is for informational purposes only and is\n        not intended to offer medical advice, or replace the recommendations of\n        your Doctor, Midwife, Physical Therapist or Medical Practitioner. Always\n        consult your Doctor before beginning any exercise program. We will not\n        be held responsible in anyway for circumstances, conditions or injuries\n        that result directly or indirectly from information provided.\n      </p>\n      <table className={\"tt\"}>\n        <tr>\n          <Columns />\n        </tr>\n        <TableData />\n      </table>\n    </>\n  );\n}\n","/Users/rctii/Projects/roddy.tomlin.life/src/app/about/it.js",[],"/Users/rctii/Projects/roddy.tomlin.life/src/app/about/childhood.js",[],"/Users/rctii/Projects/roddy.tomlin.life/src/app/about/college.js",[],"/Users/rctii/Projects/roddy.tomlin.life/src/app/about/nfl.js",[],{"ruleId":"131","replacedBy":"132"},{"ruleId":"133","replacedBy":"134"},{"ruleId":"135","severity":1,"message":"136","line":25,"column":7,"nodeType":"137","endLine":25,"endColumn":54},{"ruleId":"135","severity":1,"message":"136","line":17,"column":11,"nodeType":"137","endLine":17,"endColumn":60},{"ruleId":"138","severity":1,"message":"139","line":1,"column":8,"nodeType":"140","messageId":"141","endLine":1,"endColumn":23},{"ruleId":"138","severity":1,"message":"142","line":2,"column":8,"nodeType":"140","messageId":"141","endLine":2,"endColumn":12},{"ruleId":"143","severity":1,"message":"144","line":16,"column":11,"nodeType":"137","endLine":16,"endColumn":76},{"ruleId":"145","severity":1,"message":"146","line":16,"column":19,"nodeType":"147","messageId":"148","endLine":16,"endColumn":39},{"ruleId":"143","severity":1,"message":"144","line":25,"column":13,"nodeType":"137","endLine":25,"endColumn":25},{"ruleId":"143","severity":1,"message":"144","line":26,"column":13,"nodeType":"137","endLine":26,"endColumn":25},{"ruleId":"143","severity":1,"message":"144","line":27,"column":13,"nodeType":"137","endLine":27,"endColumn":25},{"ruleId":"138","severity":1,"message":"149","line":7,"column":3,"nodeType":"140","messageId":"141","endLine":7,"endColumn":17},{"ruleId":"138","severity":1,"message":"150","line":18,"column":10,"nodeType":"140","messageId":"141","endLine":18,"endColumn":26},{"ruleId":"138","severity":1,"message":"151","line":18,"column":28,"nodeType":"140","messageId":"141","endLine":18,"endColumn":47},{"ruleId":"143","severity":1,"message":"144","line":33,"column":7,"nodeType":"137","endLine":33,"endColumn":72},{"ruleId":"145","severity":1,"message":"146","line":33,"column":15,"nodeType":"147","messageId":"148","endLine":33,"endColumn":35},{"ruleId":"152","severity":1,"message":"153","line":10,"column":13,"nodeType":"154","endLine":31,"endColumn":4},{"ruleId":"152","severity":1,"message":"155","line":31,"column":6,"nodeType":"156","endLine":31,"endColumn":8,"suggestions":"157"},{"ruleId":"138","severity":1,"message":"158","line":1,"column":17,"nodeType":"140","messageId":"141","endLine":1,"endColumn":35},{"ruleId":"159","severity":1,"message":"160","line":53,"column":1,"nodeType":"161","endLine":57,"endColumn":3},{"ruleId":"135","severity":1,"message":"136","line":8,"column":9,"nodeType":"137","endLine":8,"endColumn":54},{"ruleId":"135","severity":1,"message":"136","line":96,"column":9,"nodeType":"137","endLine":96,"endColumn":65},{"ruleId":"135","severity":1,"message":"136","line":97,"column":9,"nodeType":"137","endLine":97,"endColumn":67},{"ruleId":"152","severity":1,"message":"153","line":10,"column":13,"nodeType":"154","endLine":31,"endColumn":4},{"ruleId":"152","severity":1,"message":"155","line":31,"column":6,"nodeType":"156","endLine":31,"endColumn":8,"suggestions":"162"},"no-native-reassign",["163"],"no-negated-in-lhs",["164"],"jsx-a11y/alt-text","img elements must have an alt prop, either with meaningful text, or an empty string for decorative images.","JSXOpeningElement","no-unused-vars","'PlaceholderText' is defined but never used.","Identifier","unusedVar","'Card' is defined but never used.","jsx-a11y/anchor-is-valid","The href attribute requires a valid value to be accessible. Provide a valid, navigable address as the href value. If you cannot provide a valid href, but still need the element to resemble a link, use a button and change it with appropriate styles. Learn more: https://github.com/evcohen/eslint-plugin-jsx-a11y/blob/master/docs/rules/anchor-is-valid.md","no-script-url","Script URL is a form of eval.","Literal","unexpectedScriptURL","'TrophyOutlined' is defined but never used.","'showBallDropdown' is assigned a value but never used.","'setShowBallDropdown' is assigned a value but never used.","react-hooks/exhaustive-deps","Effect callbacks are synchronous to prevent race conditions. Put the async function inside:\n\nuseEffect(() => {\n  async function fetchData() {\n    // You can await here\n    const response = await MyAPI.getData(someId);\n    // ...\n  }\n  fetchData();\n}, [someId]); // Or [] if effect doesn't need props or state\n\nLearn more about data fetching with Hooks: https://reactjs.org/link/hooks-data-fetching","ArrowFunctionExpression","React Hook useEffect has a missing dependency: 'moment'. Either include it or remove the dependency array.","ArrayExpression",["165"],"'AxiosRequestConfig' is defined but never used.","import/no-anonymous-default-export","Assign object to a variable before exporting as module default","ExportDefaultDeclaration",["166"],"no-global-assign","no-unsafe-negation",{"desc":"167","fix":"168"},{"desc":"167","fix":"169"},"Update the dependencies array to be: [moment]",{"range":"170","text":"171"},{"range":"172","text":"171"},[1101,1103],"[moment]",[1112,1114]]