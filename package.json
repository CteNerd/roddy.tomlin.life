{
  "name": "roddy-tomlin-profile",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/contracts",
    "packages/reporting",
    "apps/api",
    "apps/reporting-worker",
    "apps/founder-web",
    "infra"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "start": "vite --host 127.0.0.1",
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && npm run build --workspace @rct/founder-web && node scripts/prepare-release.mjs",
    "dev:founder": "npm run dev --workspace @rct/founder-web",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "npm run test:integration --workspace @rct/reporting-worker",
    "check:portfolio": "npm run check --workspaces",
    "cdk:synth:development": "npm run synth:development --workspace @rct/founder-infra",
    "cdk:synth:production": "npm run synth:production --workspace @rct/founder-infra",
    "cdk:synth:governance:development": "npm run synth:governance:development --workspace @rct/founder-infra",
    "cdk:synth:governance:production": "npm run synth:governance:production --workspace @rct/founder-infra",
    "cdk:synth:eventing:development": "npm run synth:eventing:development --workspace @rct/founder-infra",
    "cdk:synth:eventing:production": "npm run synth:eventing:production --workspace @rct/founder-infra",
    "cdk:synth:release-planning:development": "npm run synth:release-planning:development --workspace @rct/founder-infra",
    "cdk:synth:release-planning:production": "npm run synth:release-planning:production --workspace @rct/founder-infra",
    "check:deployment": "npm run check:deployment --workspace @rct/founder-infra",
    "lint": "eslint src/App.jsx src/main.jsx src/profile.js src/App.test.jsx src/setupTests.js vite.config.js eslint.config.js scripts apps/api/src apps/founder-web/src apps/founder-web/vite.config.js apps/reporting-worker/src apps/reporting-worker/test packages/reporting/src packages/contracts/src/index.ts infra/src",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^6.2.1",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^27.0.1",
    "typescript-eslint": "8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
